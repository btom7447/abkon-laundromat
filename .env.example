# --- Runtime ---
NODE_ENV=development

# --- App ---
APP_URL=http://localhost:3000
APP_NAME="Abkon Laundromat"

# --- Database ---
# For Supabase: use TWO URLs — transaction pooler (6543) for the app runtime, and
# session pooler / direct connection (5432) for Prisma migrations. The app's high-
# fanout pages (e.g. the admin dashboard) exceed the 15-connection session-mode cap.
# For local Postgres / Docker, point both at the same DB.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Auth (Auth.js v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_32_BYTE_BASE64"
AUTH_TRUST_HOST=true

# --- SMS (Termii) ---
# Termii uses a single API key (no separate secret). Find it in the Termii
# dashboard → Settings → API Keys. Leave TERMII_API_KEY blank in local dev to
# fall back to the console-log stub. Sender ID must be the exact string
# approved by Termii (3–11 alphanumeric).
TERMII_API_KEY=""
TERMII_SENDER_ID="abkon"
TERMII_BASE_URL="https://api.ng.termii.com"

# --- WhatsApp (Meta Cloud API) ---
META_WHATSAPP_PHONE_ID=""
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_VERIFY_TOKEN=""
META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
META_APP_SECRET=""

# --- Backups (Cloudflare R2) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="abkon-backups"
R2_ENDPOINT=""

# --- Security ---
# Comma-separated allowlist for admin login IPs (optional, leave blank to allow all)
ADMIN_IP_ALLOWLIST=""
# Rate limit window (seconds) and max attempts for login
LOGIN_RATE_LIMIT_WINDOW=900
LOGIN_RATE_LIMIT_MAX=5
