# --- Runtime ---
NODE_ENV=development

# --- App ---
APP_URL=http://localhost:3000
APP_NAME="Abkon Laundromat"

# --- Database ---
# Use Neon, Supabase, or local Postgres. For local dev you can use Docker.
DATABASE_URL="postgresql://user:password@localhost:5432/abkon?schema=public"

# --- Auth (Auth.js v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_32_BYTE_BASE64"
AUTH_TRUST_HOST=true

# --- SMS (Termii) ---
TERMII_API_KEY=""
TERMII_SENDER_ID="Abkon"
TERMII_BASE_URL="https://api.ng.termii.com"

# --- WhatsApp (Meta Cloud API) ---
META_WHATSAPP_PHONE_ID=""
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_VERIFY_TOKEN=""
META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
META_APP_SECRET=""

# --- Backups (Cloudflare R2) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="abkon-backups"
R2_ENDPOINT=""

# --- Security ---
# Comma-separated allowlist for admin login IPs (optional, leave blank to allow all)
ADMIN_IP_ALLOWLIST=""
# Rate limit window (seconds) and max attempts for login
LOGIN_RATE_LIMIT_WINDOW=900
LOGIN_RATE_LIMIT_MAX=5
